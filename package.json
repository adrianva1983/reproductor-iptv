  "keywords": [
    "ecosystem:cordova"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "cordova-android": "15.1.0",
    "cordova-ios": "8.1.1",
    "cordova-plugin-screen-orientation": "3.0.4",
    "cordova-plugin-statusbar": "4.0.0",
    "es6-promise-plugin": "4.2.2",
    "hls.js": "1.7.3"
  },
  "cordova": {
    "platforms": [
      "android",
      "ios"
    ],
    "plugins": {
      "cordova-plugin-statusbar": {},
      "cordova-plugin-screen-orientation": {}
    }
  },
  "private": "true"
